# VolleyVision API — environment variables
#
# Every variable the backend actually reads is listed here. Copy to
# backend/.env and fill in the blanks. Values below are placeholders — never
# commit real secrets.

# ─── Database (Supabase Postgres) ─────────────────────────────────────────────
# Pooled (pgbouncer) connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:password@localhost:5432/volleyvision"
# Non-pooled connection, used only for running migrations (see netlify.toml build
# command). In production this points at Supabase's direct/session connection
# while DATABASE_URL points at the pgbouncer transaction pooler.
DIRECT_URL="postgresql://postgres:password@localhost:5432/volleyvision"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Allowed CORS origin for the SPA.
CLIENT_URL=http://localhost:5173

# ─── Auth (REQUIRED) ──────────────────────────────────────────────────────────
# Signing key for the session JWT. auth.service.ts throws when this is unset,
# so EVERY login and register 500s without it.
# Production MUST use a strong random value — generate one with:
#   openssl rand -base64 48
JWT_SECRET=
# Token lifetime, in the `ms`/jsonwebtoken format (e.g. 15m, 12h, 7d).
# Optional — defaults to 7d when unset.
JWT_EXPIRES_IN=7d

# ─── AI Match Summary (Phase 6 Sprint 0) ──────────────────────────────────────
# Required only for the narrative endpoint; the rest of the API works without it.
ANTHROPIC_API_KEY=

# ─── Invitation & password-reset email (Gmail SMTP) ───────────────────────────
# Optional: with these unset, invitations and reset links are still created —
# they just aren't delivered by email (the join code can be shared manually).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@example.com
# TODO: generate a Gmail App Password (requires 2FA enabled on the account) at
# Google Account → Security → App Passwords, then paste it here.
SMTP_PASS=

# ─── Attachment storage (Supabase Storage) ────────────────────────────────────
# Both the app database and object storage live on Supabase; these three cover
# Storage only (the database uses DATABASE_URL above). Backs team-chat and
# feedback attachments. The client is created lazily, so leaving these unset
# degrades ONLY the attachment endpoints (clean 503) — the rest of the API boots
# and serves normally.
# The service-role key is server-only. NEVER commit or log it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_CHAT_BUCKET=team-chat

# ─── Match video storage ──────────────────────────────────────────────────────
# Match video does NOT go through the API: a Netlify Function caps a request
# payload at ~6 MB, so the browser uploads straight to the storage vendor with a
# short-lived presigned URL and the API only issues that URL and records what
# happened. The vendor sits behind an adapter — see
# backend/src/services/videoStorage/README.md and
# docs/design/video-storage-decision.md.
#
# VIDEO_STORAGE_PROVIDER — supabase | none. (r2 | stream | mux are reserved
#   names with no adapter yet.) Default `none`: every video endpoint returns a
#   clean 503 and the rest of the API is unaffected. The provider is resolved
#   lazily, so leaving all of this unset is a supported configuration.
VIDEO_STORAGE_PROVIDER=none

# The rest apply when VIDEO_STORAGE_PROVIDER=supabase. Reuses SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY above.
# VIDEO_STORAGE_BUCKET — must exist and be PRIVATE (playback is signed URLs).
#   Raise the bucket's own file-size limit to at least VIDEO_MAX_SIZE_BYTES:
#   the bucket cap, not this app, is what rejects an oversize upload mid-flight.
#   ⚠️ Uploads use TUS (resumable, 6 MB chunks) proxied through this API so the
#   service-role key stays server-side. That proxy CANNOT work on Netlify
#   Functions, whose ~6 MB payload cap is smaller than one chunk. Supabase is
#   therefore a local/self-hosted option; production needs a provider issuing
#   browser-safe credentials. See docs/design/video-storage-decision.md.
VIDEO_STORAGE_BUCKET=match-videos
# VIDEO_MAX_SIZE_BYTES — default 52428800 (50 MB), the per-file cap on a
#   Supabase Free project, which cannot be raised on that plan. Checked twice:
#   against the client's declared size before a URL is issued, and against the
#   object's real size at completion.
#   Raising this takes TWO changes — this value AND the bucket's own file-size
#   limit. Only the bucket's is enforced while bytes are moving, so a mismatch
#   fails the upload after the user has already sent megabytes.
#   Run `npm run check:video` to verify the two agree against the live bucket.
#   Free-tier totals to keep in view: 1 GB of storage and 5 GB egress/month.
VIDEO_MAX_SIZE_BYTES=52428800
# VIDEO_UPLOAD_URL_TTL_SECONDS — default 3600. Supabase's resumable upload
#   tokens last a fixed 2 hours, so for that provider this can only bring the
#   reported deadline forward, never extend it. An upload that outlives its
#   token recovers via POST /videos/:videoId/refresh-upload.
VIDEO_UPLOAD_URL_TTL_SECONDS=3600
# VIDEO_PLAYBACK_URL_TTL_SECONDS — default 3600. Long enough to watch a match
#   through without re-signing.
VIDEO_PLAYBACK_URL_TTL_SECONDS=3600

# ─── Platform / tooling (do not set by hand) ──────────────────────────────────
# NETLIFY — set by Netlify in build and function contexts; index.ts reads it to
#   skip app.listen() when running inside a serverless function.
# SMOKE_PORT — read only by backend/scripts/smoke-*.ts when running the local
#   smoke harness; unset in normal development.

# VolleyVision STAGING — local environment for staging tooling
#
# Copy to backend/.env.staging (gitignored) and fill in. Used by:
#   - deploy.ps1 -Target staging   (migrate status, --site, smoke check)
#   - npm run db:seed:staging      (load these into the shell first)
#   - npx prisma migrate deploy    (load these into the shell first)
# Never point any of these at the production project. Never commit the real file.

# ─── Staging Supabase database ────────────────────────────────────────────────
# Pooler connection (port 6543, same query parameters as prod's DATABASE_URL).
DATABASE_URL="postgresql://postgres.<staging-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session connection (port 5432), used for migrations.
DIRECT_URL="postgresql://postgres.<staging-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# The staging project ref. seed-staging.ts refuses any DATABASE_URL that
# doesn't contain it (and any that contains the prod ref).
STAGING_PROJECT_REF=<staging-ref>

# ─── Seed ─────────────────────────────────────────────────────────────────────
# Password for every seed login (staging+<role>@volleyvision.test). 12+ chars.
SEED_PASSWORD=

# ─── Netlify staging site ─────────────────────────────────────────────────────
NETLIFY_STAGING_SITE_ID=
STAGING_URL=https://volleyvision-staging.netlify.app

# ─── Smoke check (backend/scripts/smoke.mjs) ──────────────────────────────────
SMOKE_EMAIL=staging+owner@volleyvision.test
SMOKE_PASSWORD=
SMOKE_OUTSIDER_EMAIL=staging+outsider@volleyvision.test
SMOKE_OUTSIDER_PASSWORD=
# Printed by `npm run db:seed:staging`.
SMOKE_TEAM_ID=staging-falcons
SMOKE_MATCH_ID=staging-falcons-m1

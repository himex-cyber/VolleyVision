# Android emulator build against the local stack (npm run android:local).
# Committed on purpose: no secrets. 10.0.2.2 is the emulator's route to the PC.
VITE_API_URL=http://10.0.2.2:3001/api/v1
VITE_SENTRY_ENVIRONMENT=android-local
# Sentry is off locally. Set empty on purpose: without it, a DSN in .env.local
# would be picked up and emulator errors would use up the Sentry quota.
VITE_SENTRY_DSN=
VITE_APP_VERSION=9.10.0

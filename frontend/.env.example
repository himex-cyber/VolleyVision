# VolleyVision frontend environment variables
#
# API base URL for the backend.
# Leave unset in local development — the default '/api/v1' goes through the
# Vite dev proxy (see vite.config.ts). Set an absolute URL when the frontend
# is served from a different origin than the API (e.g. a deployed SPA or the
# future mobile client).
#
# VITE_API_URL=https://api.example.com/api/v1

# --- Error tracking (Sentry) -------------------------------------------------
# DSN is a public write-only ingestion key, safe to commit -- unset locally is
# normal (see src/main.tsx).
VITE_SENTRY_DSN=https://28f242a9d46cc8b319b5953a6ac7d6c2@o4512011942494208.ingest.us.sentry.io/4512156787605504
# Sentry environment tag. Unset falls back to Vite's MODE. Set to "staging" on
# the staging site, which builds in production mode.
# VITE_SENTRY_ENVIRONMENT=staging

# Source-map upload for readable production stack traces (build-time only,
# not shipped to the browser). Unset locally/CI is normal -- the build just
# skips the upload (see vite.config.ts). SENTRY_AUTH_TOKEN is a secret Sentry
# API token -- set as a Netlify env var only, never commit a real value here.
# SENTRY_AUTH_TOKEN=
# SENTRY_PROJECT=volleyvision
